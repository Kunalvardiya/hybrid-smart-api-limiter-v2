# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Redis password. REQUIRED: docker compose refuses to start while this is empty.
# Generate one (PowerShell):  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
REDIS_PASSWORD=
# Host used when running the apps on your machine (outside Docker).
# Inside docker-compose the services use REDIS_HOST=redis automatically.
REDIS_HOST=localhost
REDIS_PORT=6379

# Where the gateway forwards allowed requests
BACKEND_URL=http://localhost:9000

# Token bucket: capacity = max burst, refill = sustained requests/second per client
BUCKET_CAPACITY=20
BUCKET_REFILL_PER_SEC=10

# Behaviour if Redis is unreachable: open = let traffic through, closed = reject with 503
RATE_LIMIT_FAIL_MODE=open
REDIS_TIMEOUT_S=0.5

# Telemetry stream length cap and in-memory queue size
TELEMETRY_STREAM_MAXLEN=100000
TELEMETRY_QUEUE_SIZE=10000
# Seconds between heartbeat events that let the worker see an idle system as quiet (0 disables)
TELEMETRY_TICK_S=1

# Comma-separated API keys the gateway recognises (leave empty in development only).
# Unknown keys are treated as their source IP, so inventing keys gains nothing.
ALLOWED_API_KEYS=

# Behavioural scoring (all optional; defaults and meaning in docs/SCORING.md)
# SCORING_SPAN_S=10
# SCORING_ALPHA=0.02
# SCORING_BURST_REF=10   (defaults to BUCKET_REFILL_PER_SEC)

# Enforcement policy (all optional; defaults and meaning in docs/POLICY.md)
# POLICY_ENTER_MONITORED=25
# POLICY_ENTER_THROTTLED=50
# POLICY_ENTER_BLOCKED=75
# POLICY_HYSTERESIS=5
# POLICY_DWELL_BLOCKED_S=60
# POLICY_THROTTLE_MULTIPLIER=0.25

# Token for the read-only /admin API and /dashboard data. Empty = admin API disabled.
# Generate a long random value; never commit it.
ADMIN_TOKEN=
